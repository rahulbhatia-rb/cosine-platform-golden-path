{
  "service": "agent-api",
  "environment": "production",
  "tenant": "cosine-managed",
  "replicas": 3,
  "cpu_request": "500m",
  "cpu_limit": "2",
  "memory_request": "1Gi",
  "memory_limit": "4Gi",
  "min_replicas": 3,
  "max_replicas": 20,
  "readiness_probe": true,
  "liveness_probe": true,
  "pod_disruption_budget": true,
  "secret_source": "aws-secrets-manager",
  "egress_policy": "allowlisted",
  "public_admin_ingress": false,
  "backup_restore": false,
  "stateful": false,
  "isolated_environment": true,
  "slo": {"availability_percent": 99.9, "p95_latency_ms": 500},
  "observability": {"metrics": true, "logs": true, "traces": true},
  "rollout": {"strategy": "canary", "rollback_enabled": true}
}
